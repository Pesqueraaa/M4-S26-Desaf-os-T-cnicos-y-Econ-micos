function ejecutar() {
  let consultas = 12000 * 2;
  let tokensEntrada = consultas * 2500;
  let tokensSalida = consultas * 600;

  let ahorroMin = (12 - 8) * 12000;
  let horas = ahorroMin / 60;
  let ahorro = horas * 22;

  document.getElementById("resultados").innerHTML =
    `Consultas: ${consultas} <br>
     Tokens entrada: ${tokensEntrada} <br>
     Tokens salida: ${tokensSalida} <br>
     Horas ahorradas: ${horas} <br>
     Ahorro: €${ahorro}`;
}
